# ══════════════════════════════════════════════════════════════════════════════
# Nanban AI — PRODUCTION Environment Variables
# Copy these into your cloud server's environment (Render / Railway / EC2 etc.)
# DO NOT commit this file with real keys — it is for reference only.
# ══════════════════════════════════════════════════════════════════════════════

GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
ADMIN_PASSWORD=your_strong_admin_password_here

# ── Local SQLite Storage (Default) ────────────────────────────────────────────
# Storage is automatically handled locally via SQLite (memory.db)

# ── STT Mode ──────────────────────────────────────────────────────────────────
# Use 'api' on cloud servers (no GPU, no local model download needed).
# The SAME Groq API key above is used for Whisper transcription.
STT_MODE=api

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=your_redis_cloud_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_cloud_password

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set this to your deployed frontend origin with no trailing slash.
# If the admin panel uses a separate subdomain, add it as a comma-separated origin too.
# CORS_ORIGINS=https://your-frontend-domain.vercel.app
