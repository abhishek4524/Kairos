{
  "name": "Arya",
  "productName": "Arya",
  "version": "1.0.0",
  "description": "Arya — Personal Female AI Assistant",
  "main": "main.js",
  "author": "Abhishek Kumar",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:all": "electron-builder --win --x64 --publish=never"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.abhishek.arya",
    "productName": "Arya",
    "copyright": "Copyright 2025 Abhishek Kumar",
    "publish": null,
    "directories": {
      "output": "C:\\arya-build-output"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "asarUnpack": [
      "backend/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!venv/Lib/site-packages/torch/**",
          "!venv/Lib/site-packages/nvidia/**",
          "!venv/Lib/site-packages/triton/**",
          "!venv/Lib/site-packages/~*/**"
        ]
      },
      {
        "from": "../models",
        "to": "models",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arya",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Arya-Portable-${version}.exe"
    }
  }
}

